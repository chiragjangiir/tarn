// Blocking Linux child processes. No implicit shell or async process runtime.
import "io"
import "fs"
import "net"
import "string"

pub struct Command {
    program string
    arguments Vec<string>
    /// `KEY=value` overrides on top of the inherited environment.
    environment Vec<string>
    directory string
    use_directory bool
    /// Two bits per stream (stdin, stdout, stderr): 0 inherit, 1 null, 2 piped.
    stdio i32
}
/// A Command with owned handoffs (ADR 0071). It launches once and consumes
/// the handed-over streams, so the parent's copies close at launch.
pub struct Launch {
    command Command
    passed Vec<_Handoff>
}
/// One owned handoff; its position decides the child descriptor.
enum _Handoff {
    Stream(net.UnixStream)
    File(fs.File)
}
/// Where a child's standard stream goes. `Piped` requires `start_child`.
pub copy enum Stdio {
    Inherit
    Null
    Piped
}
/// A started child with the parent ends of its piped streams. Fields drop in
/// declaration order: the pipes close before `process` waits, so destroying
/// a Child never deadlocks on a child that reads stdin until end of file.
pub struct Child {
    pub stdin Option<ChildStdin>
    pub stdout Option<ChildStdout>
    pub stderr Option<ChildStderr>
    pub process Process
}
/// Write end of a child's stdin. Close or drop it to send end of file.
pub struct ChildStdin { pipe _Pipe }
/// Read end of a child's stdout.
pub struct ChildStdout { pipe _Pipe }
/// Read end of a child's stderr.
pub struct ChildStderr { pipe _Pipe }
/// Unique child completion authority. Transfer, not Share; drop waits/reaps.
pub struct Process { pid i32 }
struct _Pipe { fd i32 }
struct _Launch { child Process
    stdout Option<_Pipe>
    stderr Option<_Pipe> }
pub copy enum ExitStatus { Exited(i32)
    Signaled(i32) }
pub struct Output { pub status ExitStatus
    pub stdout Vec<u8>
    pub stderr Vec<u8> }
extern "intrinsic" fn _spawn(program &string, arguments &[]string, environment &[]string, directory &string, use_directory bool, capture bool, stdio i32, passed &[]i32) io._Raw
extern "intrinsic" fn _poll_exit(pid i32, timeout i32) io._Raw
extern "intrinsic" fn _wait(child Process) io._Raw
extern "intrinsic" fn _close(pipe _Pipe) io._Raw
extern "intrinsic" fn _kill(pid i32) io._Raw
extern "intrinsic" fn _terminate(pid i32) io._Raw
extern "intrinsic" fn _read(fd i32, data &mut []u8) io._Raw
extern "intrinsic" fn _write(fd i32, data &[]u8) io._Raw
extern "intrinsic" fn _pidfd(pid i32) io._Raw

pub fn Command.new(program string) Command {
    arguments: Vec<string> := Vec.new()
    environment: Vec<string> := Vec.new()
    return Command{program: program, arguments: arguments, environment: environment, directory: "", use_directory: false, stdio: 0}
}
/// Set `key` for the child, replacing an inherited value; the parent's own
/// environment is unchanged. A key that is empty or contains `=` or NUL, or
/// a value containing NUL, makes spawning fail with InvalidInput.
pub fn Command.env(self, key string, value string) Command {
    var command = self
    var valid = !key.is_empty()
    for byte in key.bytes() {
        if byte == 61 { valid = false }
    }
    // An invalid key is stored as "=..." so the native bridge rejects it.
    if valid { command.environment.push(key + "=" + &value) } else { command.environment.push("=" + &key) }
    return command
}
pub fn Command.arg(self, value string) Command {
    var command = self
    command.arguments.push(value)
    return command
}
pub fn Command.args(self, values &[]string) Command {
    var command = self
    for value in values { command.arguments.push(value.clone()) }
    return command
}
pub fn Command.current_dir(self, value string) Command {
    var command = self
    command.directory = value
    command.use_directory = true
    return command
}
fn _stdio(mode Stdio, shift i32, current i32) i32 {
    // Clear this stream's two bits, then set its mode.
    old := (current / shift) % 4
    cleared := current - old * shift
    match mode { Stdio.Inherit => { return cleared }
        Stdio.Null => { return cleared + shift }
        Stdio.Piped => { return cleared + 2 * shift } }
}
fn _mode(stdio i32, shift i32) i32 { return (stdio / shift) % 4 }
/// Child stdin; `output` always uses /dev/null.
pub fn Command.stdin(self, mode Stdio) Command {
    var command = self
    command.stdio = _stdio(mode, 1, command.stdio)
    return command
}
/// Child stdout; `output` always captures it.
pub fn Command.stdout(self, mode Stdio) Command {
    var command = self
    command.stdio = _stdio(mode, 4, command.stdio)
    return command
}
/// Child stderr; `output` always captures it.
pub fn Command.stderr(self, mode Stdio) Command {
    var command = self
    command.stdio = _stdio(mode, 16, command.stdio)
    return command
}
/// Hands `stream` to the child: the k-th handoff (from zero) becomes the
/// child's descriptor 3 + k, and nothing else is inherited. The result is a
/// one-shot Launch; launching consumes the streams, closing the parent's
/// copies (ADR 0071). More than 64 handoffs make launching fail with
/// InvalidInput.
pub fn Command.pass(self, stream net.UnixStream) Launch {
    var passed: Vec<_Handoff> = Vec.new()
    passed.push(_Handoff.Stream(stream))
    return Launch{command: self, passed: passed}
}
/// Hands an open file to the child, numbered like `pass` (ADR 0071).
pub fn Command.pass_file(self, file fs.File) Launch {
    var passed: Vec<_Handoff> = Vec.new()
    passed.push(_Handoff.File(file))
    return Launch{command: self, passed: passed}
}
pub fn Launch.pass(self, stream net.UnixStream) Launch {
    var launch = self
    launch.passed.push(_Handoff.Stream(stream))
    return launch
}
pub fn Launch.pass_file(self, file fs.File) Launch {
    var launch = self
    launch.passed.push(_Handoff.File(file))
    return launch
}
pub fn Launch.stdin(self, mode Stdio) Launch {
    var launch = self
    launch.command = launch.command.stdin(mode)
    return launch
}
pub fn Launch.stdout(self, mode Stdio) Launch {
    var launch = self
    launch.command = launch.command.stdout(mode)
    return launch
}
pub fn Launch.stderr(self, mode Stdio) Launch {
    var launch = self
    launch.command = launch.command.stderr(mode)
    return launch
}
fn _descriptor(raw io._Raw, offset usize) i32 {
    return i32(raw.address[offset]) + i32(raw.address[offset + 1]) * 256 +
        i32(raw.address[offset + 2]) * 65536 + i32(raw.address[offset + 3]) * 16777216
}
fn _optional(raw io._Raw, stdio i32, shift i32, offset usize) Option<_Pipe> {
    if _mode(stdio, shift) == 2 { return Some(_Pipe{fd: _descriptor(raw, offset)}) }
    return None
}
fn _start(command &Command, passed &[]_Handoff) Result<Child, io.Error> {
    var fds: Vec<i32> = Vec.new()
    for handoff in passed {
        match handoff { _Handoff.Stream(stream) => { fds.push(stream.stream.fd) }
            _Handoff.File(file) => { fds.push(file.fd) } }
    }
    raw := try io._check(_spawn(&command.program, command.arguments.as_slice(), command.environment.as_slice(), &command.directory, command.use_directory, false, command.stdio, fds.as_slice()))
    child := Process{pid: i32(raw.value)}
    var stdin: Option<ChildStdin> = None
    var stdout: Option<ChildStdout> = None
    var stderr: Option<ChildStderr> = None
    match _optional(raw, command.stdio, 1, 8) { Some(pipe) => { stdin = Some(ChildStdin{pipe: pipe}) }
        None => {} }
    match _optional(raw, command.stdio, 4, 0) { Some(pipe) => { stdout = Some(ChildStdout{pipe: pipe}) }
        None => {} }
    match _optional(raw, command.stdio, 16, 4) { Some(pipe) => { stderr = Some(ChildStderr{pipe: pipe}) }
        None => {} }
    return Ok(Child{stdin: stdin, stdout: stdout, stderr: stderr, process: child})
}
fn _launch(command &Command, capture bool) Result<_Launch, io.Error> {
    var fds: Vec<i32> = Vec.new()
    raw := try io._check(_spawn(&command.program, command.arguments.as_slice(), command.environment.as_slice(), &command.directory, command.use_directory, capture, command.stdio, fds.as_slice()))
    child := Process{pid: i32(raw.value)}
    if capture {
        stdout := _Pipe{fd: _descriptor(raw, 0)}
        stderr := _Pipe{fd: _descriptor(raw, 4)}
        return Ok(_Launch{child: child, stdout: Some(stdout), stderr: Some(stderr)})
    }
    return Ok(_Launch{child: child, stdout: None, stderr: None})
}
fn _unpiped(stdio i32) Result<void, io.Error> {
    if _mode(stdio, 1) == 2 || _mode(stdio, 4) == 2 || _mode(stdio, 16) == 2 { return Err(io.Error.new(io.ErrorKind.InvalidInput)) }
    return Ok(())
}
/// Starts the child. A `Stdio.Piped` stream is InvalidInput here: use
/// `start_child`, which returns the pipe ends.
pub fn Command.start(&self) Result<Process, io.Error> {
    try _unpiped(self.stdio)
    launched := try _launch(self, false)
    return Ok(launched.child)
}
pub fn Command.status(&self) Result<ExitStatus, io.Error> {
    child := try self.start()
    return child.wait()
}
/// Starts the child and returns the parent ends of its piped streams.
pub fn Command.start_child(&self) Result<Child, io.Error> {
    none: Vec<_Handoff> := Vec.new()
    return _start(self, none.as_slice())
}
pub fn Launch.start(self) Result<Process, io.Error> {
    try _unpiped(self.command.stdio)
    child := try self.start_child()
    return Ok(child.process)
}
pub fn Launch.status(self) Result<ExitStatus, io.Error> {
    child := try self.start()
    return child.wait()
}
/// Launches once. The handed-over streams are destroyed when this returns,
/// on success or failure, so the parent keeps no copy (ADR 0071).
pub fn Launch.start_child(self) Result<Child, io.Error> {
    return _start(&self.command, self.passed.as_slice())
}
fn _pipe(value Option<_Pipe>) _Pipe {
    match value { Some(pipe) => { return pipe }
        None => { panic("internal process capture invariant") } }
}
fn _Pipe.read_all(self) Result<Vec<u8>, io.Error> {
    var output: Vec<u8> = Vec.new()
    var buffer: Vec<u8> = Vec.new()
    var index: usize = 0
    for index < 4096 { buffer.push(0)
        index = index + 1 }
    for {
        raw := _read(self.fd, buffer.as_mut_slice())
        if raw.domain == 4 && raw.code == 4 { continue }
        checked := try io._check(raw)
        count := usize(checked.value)
        if count == 0 { _close(self)
            return Ok(output) }
        data := buffer.as_slice()
        for byte in &data[..count] { output.push(byte) }
    }
}
/// Captures bytes; two native readers drain both pipes concurrently. Child
/// stdin is /dev/null. Output buffers are unbounded and descendants may hold
/// pipe writers open. This is deliberately blocking, without timeouts.
pub fn Command.output(&self) Result<Output, io.Error> {
    launched := try _launch(self, true)
    child := launched.child
    stdout := _pipe(launched.stdout)
    stderr := _pipe(launched.stderr)
    first := spawn move fn() Result<Vec<u8>, io.Error> { return stdout.read_all() }
    second := spawn move fn() Result<Vec<u8>, io.Error> { return stderr.read_all() }
    status := try child.wait()
    out := try first.join()
    err := try second.join()
    return Ok(Output{status: status, stdout: out, stderr: err})
}
// Pipe ends (ADR 0071). EINTR retries here; EAGAIN on a nonblocking pipe is
// WouldBlock, as for sockets. Writes never raise SIGPIPE: a closed reader is
// BrokenPipe.
fn _pipe_error(raw io._Raw) io.Error {
    if raw.domain == 4 && raw.code == 11 { return io.Error{kind: io.ErrorKind.WouldBlock, code: 11, domain: 4} }
    if raw.domain == 4 && raw.code == 32 { return io.Error{kind: io.ErrorKind.BrokenPipe, code: 32, domain: 4} }
    return io._error(raw)
}
fn _pipe_read(fd i32, buffer &mut []u8) Result<usize, io.Error> {
    for {
        raw := _read(fd, buffer)
        if raw.domain == 4 && raw.code == 4 { continue }
        if raw.domain != 0 || raw.code != 0 { return Err(_pipe_error(raw)) }
        return Ok(usize(raw.value))
    }
}
fn _pipe_write(fd i32, buffer &[]u8) Result<usize, io.Error> {
    for {
        raw := _write(fd, buffer)
        if raw.domain == 4 && raw.code == 4 { continue }
        if raw.domain != 0 || raw.code != 0 { return Err(_pipe_error(raw)) }
        return Ok(usize(raw.value))
    }
}
fn _register(fd i32, poll &mut net.Poll, interest net.Interest) Result<net.Token, io.Error> {
    return net._registration(poll.handle, fd, 0, interest, net.Token{value: 0})
}
fn _deregister(fd i32, poll &mut net.Poll, token net.Token) Result<void, io.Error> {
    try net._registration(poll.handle, fd, 2, net.Interest.Readable, token)
    return Ok(())
}
/// Partial write; a child that closed its stdin makes this BrokenPipe.
pub fn ChildStdin.write(&mut self, buffer &[]u8) Result<usize, io.Error> { return _pipe_write(self.pipe.fd, buffer) }
/// Blocking-only complete write; WouldBlock on a nonblocking pipe.
pub fn ChildStdin.write_all(&mut self, buffer &[]u8) Result<void, io.Error> {
    var offset = usize(0)
    for offset < buffer.len() {
        count := try self.write(&buffer[offset..])
        if count == 0 { return Err(io.Error{kind: io.ErrorKind.WriteZero, code: 0, domain: 0}) }
        offset = offset + count
    }
    return Ok(())
}
/// Sends end of file to the child.
pub fn ChildStdin.close(self) { _close(self.pipe) }
pub fn ChildStdin.set_nonblocking(&mut self, enabled bool) Result<void, io.Error> { return net._set_nonblocking(self.pipe.fd, enabled) }
pub fn ChildStdin.register(&self, poll &mut net.Poll) Result<net.Token, io.Error> { return _register(self.pipe.fd, poll, net.Interest.Writable) }
pub fn ChildStdin.deregister(&self, poll &mut net.Poll, token net.Token) Result<void, io.Error> { return _deregister(self.pipe.fd, poll, token) }
/// Partial read; zero is end of file.
pub fn ChildStdout.read(&mut self, buffer &mut []u8) Result<usize, io.Error> { return _pipe_read(self.pipe.fd, buffer) }
/// Reads to end of file; unbounded, blocking.
pub fn ChildStdout.read_all(self) Result<Vec<u8>, io.Error> { return self.pipe.read_all() }
pub fn ChildStdout.close(self) { _close(self.pipe) }
pub fn ChildStdout.set_nonblocking(&mut self, enabled bool) Result<void, io.Error> { return net._set_nonblocking(self.pipe.fd, enabled) }
pub fn ChildStdout.register(&self, poll &mut net.Poll) Result<net.Token, io.Error> { return _register(self.pipe.fd, poll, net.Interest.Readable) }
pub fn ChildStdout.deregister(&self, poll &mut net.Poll, token net.Token) Result<void, io.Error> { return _deregister(self.pipe.fd, poll, token) }
pub fn ChildStderr.read(&mut self, buffer &mut []u8) Result<usize, io.Error> { return _pipe_read(self.pipe.fd, buffer) }
pub fn ChildStderr.read_all(self) Result<Vec<u8>, io.Error> { return self.pipe.read_all() }
pub fn ChildStderr.close(self) { _close(self.pipe) }
pub fn ChildStderr.set_nonblocking(&mut self, enabled bool) Result<void, io.Error> { return net._set_nonblocking(self.pipe.fd, enabled) }
pub fn ChildStderr.register(&self, poll &mut net.Poll) Result<net.Token, io.Error> { return _register(self.pipe.fd, poll, net.Interest.Readable) }
pub fn ChildStderr.deregister(&self, poll &mut net.Poll, token net.Token) Result<void, io.Error> { return _deregister(self.pipe.fd, poll, token) }
/// Closes stdin (end of file), then waits. stdout/stderr stay open: a child
/// that fills an unread pipe blocks, so drain them first or concurrently.
pub fn Child.wait(self) Result<ExitStatus, io.Error> {
    var child = self
    child.stdin = None
    return child.process.wait()
}
/// Writes `input` to stdin and drains stdout and stderr on three native
/// tasks, then waits (ADR 0072). Concurrent draining means a full pipe cannot
/// deadlock the child. A child that exits without reading all input is not
/// an error. Streams that are not piped come back empty. Unbounded and
/// blocking; compose with `wait_timeout` beforehand for a deadline.
pub fn Child.communicate(self, input Vec<u8>) Result<Output, io.Error> {
    var child = self
    stdin := child.stdin
    child.stdin = None
    stdout := child.stdout
    child.stdout = None
    stderr := child.stderr
    child.stderr = None
    writer := spawn move fn() Result<void, io.Error> {
        match stdin {
            Some(pipe) => {
                var end = pipe
                match end.write_all(input.as_slice()) {
                    Ok(value) => {}
                    Err(error) => { if error.kind != io.ErrorKind.BrokenPipe { return Err(error) } }
                }
            }
            None => {}
        }
        return Ok(())
    }
    first := spawn move fn() Result<Vec<u8>, io.Error> {
        match stdout { Some(pipe) => { return pipe.read_all() }
            None => { return Ok(Vec.new()) } }
    }
    second := spawn move fn() Result<Vec<u8>, io.Error> {
        match stderr { Some(pipe) => { return pipe.read_all() }
            None => { return Ok(Vec.new()) } }
    }
    try writer.join()
    status := try child.process.wait()
    out := try first.join()
    err := try second.join()
    return Ok(Output{status: status, stdout: out, stderr: err})
}
// Async pipe I/O and completion (ADR 0072): the same Pending/Ready/Waker
// model as sockets; pipes must be nonblocking.
fn _poll_pipe_read(waker &io.Waker, fd i32, buffer &mut []u8) io.Progress<Result<usize, io.Error>> {
    match net._require_nonblocking(fd) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match _pipe_read(fd, buffer) {
        Ok(count) => { return io.Progress.Ready(Ok(count)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    match io._arm(waker, fd, 1) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match _pipe_read(fd, buffer) {
        Ok(count) => { return io.Progress.Ready(Ok(count)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    return io.Progress.Pending
}
fn _poll_pipe_write(waker &io.Waker, fd i32, buffer &[]u8) io.Progress<Result<usize, io.Error>> {
    match net._require_nonblocking(fd) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match _pipe_write(fd, buffer) {
        Ok(count) => { return io.Progress.Ready(Ok(count)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    match io._arm(waker, fd, 2) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match _pipe_write(fd, buffer) {
        Ok(count) => { return io.Progress.Ready(Ok(count)) }
        Err(error) => { if !io._would_block(error) { return io.Progress.Ready(Err(error)) } }
    }
    return io.Progress.Pending
}
async fn _read_async(fd i32, buffer &mut []u8) Result<usize, io.Error> {
    for {
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<usize, io.Error>> { return io._leaf(waker, _poll_pipe_read(waker, fd, buffer)) }) {
            io.Progress.Ready(result) => { return result }
            io.Progress.Pending => {}
        }
        io._async_park()
    }
}
async fn _write_async(fd i32, buffer &[]u8) Result<usize, io.Error> {
    for {
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<usize, io.Error>> { return io._leaf(waker, _poll_pipe_write(waker, fd, buffer)) }) {
            io.Progress.Ready(result) => { return result }
            io.Progress.Pending => {}
        }
        io._async_park()
    }
}
pub async fn ChildStdout.read_async(&mut self, buffer &mut []u8) Result<usize, io.Error> { return await _read_async(self.pipe.fd, buffer) }
pub async fn ChildStderr.read_async(&mut self, buffer &mut []u8) Result<usize, io.Error> { return await _read_async(self.pipe.fd, buffer) }
pub async fn ChildStdin.write_async(&mut self, buffer &[]u8) Result<usize, io.Error> { return await _write_async(self.pipe.fd, buffer) }
pub async fn ChildStdin.write_all_async(&mut self, buffer &[]u8) Result<void, io.Error> {
    var offset = usize(0)
    for offset < buffer.len() {
        count := try await _write_async(self.pipe.fd, &buffer[offset..])
        if count == 0 { return Err(io.Error{kind: io.ErrorKind.WriteZero, code: 0, domain: 0}) }
        offset = offset + count
    }
    return Ok(())
}
fn _poll_exited(waker &io.Waker, child &Process, watch &_Pipe) io.Progress<Result<bool, io.Error>> {
    match _exit(child, 0) { Ok(found) => { match found { Some(status) => { return io.Progress.Ready(Ok(true)) }
                None => {} } }
        Err(error) => { return io.Progress.Ready(Err(error)) } }
    match io._arm(waker, watch.fd, 1) { Err(error) => { return io.Progress.Ready(Err(error)) }
        Ok(value) => {} }
    match _exit(child, 0) { Ok(found) => { match found { Some(status) => { return io.Progress.Ready(Ok(true)) }
                None => {} } }
        Err(error) => { return io.Progress.Ready(Err(error)) } }
    return io.Progress.Pending
}
/// Waits for completion without blocking the executor, then reaps (ADR
/// 0072). A pidfd owned by this frame signals readiness. If the operation is
/// abandoned (timeout, task drop), its frame destroys the Process, which
/// waits as always: kill first when abandoning a child that may not exit.
pub async fn Process.wait_async(self) Result<ExitStatus, io.Error> {
    child := self
    raw := try io._check(_pidfd(child.pid))
    watch := _Pipe{fd: i32(raw.value)}
    for {
        match io._with_waker(fn(waker &io.Waker) io.Progress<Result<bool, io.Error>> { return io._leaf(waker, _poll_exited(waker, &child, &watch)) }) {
            io.Progress.Ready(result) => {
                try result
                break
            }
            io.Progress.Pending => {}
        }
        io._async_park()
    }
    _close(watch)
    return child.wait()
}
pub fn Process.id(&self) u32 { return u32(self.pid) }
/// Consumes completion authority, including on a wait error. EINTR retry is
/// inside the native consuming bridge, so ownership is never duplicated.
pub fn Process.wait(self) Result<ExitStatus, io.Error> {
    raw := try io._check(_wait(self))
    if raw.address[0] == 0 { return Ok(ExitStatus.Exited(i32(raw.value))) }
    return Ok(ExitStatus.Signaled(i32(raw.value)))
}
fn _exit(child &Process, timeout i32) Result<Option<ExitStatus>, io.Error> {
    raw := try io._check(_poll_exit(child.pid, timeout))
    if raw.address[1] == 0 { return Ok(None) }
    if raw.address[0] == 0 { return Ok(Some(ExitStatus.Exited(i32(raw.value)))) }
    return Ok(Some(ExitStatus.Signaled(i32(raw.value))))
}
/// The exit status if the child has finished, without blocking (ADR 0070).
/// It does not reap: `wait` or destruction still completes the child, and
/// returns at once after a Some.
pub fn Process.try_wait(&mut self) Result<Option<ExitStatus>, io.Error> { return _exit(self, 0) }
/// Waits up to `millis` (zero or more) for the child to finish; None means it
/// is still running and remains owned, e.g. to `kill` and then `wait`.
pub fn Process.wait_timeout(&mut self, millis i32) Result<Option<ExitStatus>, io.Error> { return _exit(self, millis) }
/// Requests SIGKILL for this child; it still must be waited/reaped.
pub fn Process.kill(&mut self) Result<void, io.Error> {
    try io._check(_kill(self.pid))
    return Ok(())
}
/// Requests SIGTERM, letting the child shut down cleanly (ADR 0073). It keeps
/// ownership and must still be waited; escalate with `wait_timeout` + `kill`.
/// Signalling an exited but unreaped child is harmless: the pid stays owned
/// until `wait`, so it can never reach a recycled process.
pub fn Process.terminate(&mut self) Result<void, io.Error> {
    try io._check(_terminate(self.pid))
    return Ok(())
}
pub fn ExitStatus.success(&self) bool {
    match self { ExitStatus.Exited(code) => { return code == 0 }
        ExitStatus.Signaled(signal) => { return false } }
}
pub fn ExitStatus.code(&self) Option<i32> {
    match self { ExitStatus.Exited(code) => { return Some(code) }
        ExitStatus.Signaled(signal) => { return None } }
}
pub fn ExitStatus.signal(&self) Option<i32> {
    match self { ExitStatus.Exited(code) => { return None }
        ExitStatus.Signaled(signal) => { return Some(signal) } }
}
fn _text(data &[]u8) Result<string, io.Error> {
    match string.from_utf8(data) { Some(text) => { return Ok(text) }
        None => { return Err(io.Error.new(io.ErrorKind.InvalidData)) } }
}
pub fn Output.stdout_text(&self) Result<string, io.Error> { return _text(self.stdout.as_slice()) }
pub fn Output.stderr_text(&self) Result<string, io.Error> { return _text(self.stderr.as_slice()) }
