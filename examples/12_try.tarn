import "fs"
import "io"
import "string"

struct Config {
    name string
    port u16
}

fn load(path &string) Result<Config, io.Error> {
    text := try fs.read_text(path)
    name := try first_line(&text)
    return Ok(Config{name: name, port: 8080})
}

fn first_line(text &string) Result<string, io.Error> {
    lines := string.lines(text)
    if lines.is_empty() { return Err(io.Error.new(io.ErrorKind.InvalidData)) }
    return Ok(lines.get(usize(0)).clone())
}

fn main() {
    path := "/tmp/tarn-example-12.conf"
    match fs.write_text(&path, &"orvix\nunused") {
        Ok(_) => {}
        Err(error) => print("could not write sample config")
    }
    match load(&path) {
        Ok(config) => {
            print(config.name)
            print(config.port)
        }
        Err(error) => print("could not load config")
    }
    match load(&"/tmp/tarn-example-12-missing.conf") {
        Ok(config) => print(config.name)
        Err(error) => print("missing config reported as error")
    }
}
