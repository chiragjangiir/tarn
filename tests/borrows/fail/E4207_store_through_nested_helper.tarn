struct Session { value i32 }
fn store(slot &mut Option<&Session>, s &Session) { *slot = Some(s) }
fn relay(slot &mut Option<&Session>, s &Session) { store(slot, s) }
fn scoped(slot &mut Option<&Session>) {
    local := Session{value: 42}
    relay(slot, &local)
}
fn main() {
    var saved: Option<&Session> = None
    scoped(&mut saved)
    match saved { Some(s) => { print(s.value) }
        None => {} }
}
